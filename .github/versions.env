# Version and digest pins for every workflow in this repository.
#
# SINGLE SOURCE OF TRUTH.  A workflow loads this file as its first step
# through .github/scripts/load-versions.sh and takes every version from
# here; ci/build.sh reads it too, so a local run verifies the same way a
# continuous integration run does.  Nothing else may name a version.
#
# Version and digest sit on adjacent lines on purpose: they are changed by
# one hand in one file, so a version cannot move while its digest stays
# behind.
#
# WHAT THE DIGESTS DO AND DO NOT PROVE.  They pin what we build against: a
# changed archive, a truncated download or a poisoned build cache fails the
# build instead of being compiled.  They say nothing about provenance.
# nginx.org publishes a detached signature next to each archive
# (nginx-<version>.tar.gz.asc) and that is what would prove it; this does
# not check it.
#
# Keep KEY=value, no spaces around the equals sign.  The file is SOURCED by
# ci/build.sh and by the workflow steps that need a version, so a value
# holding more than one word is quoted; .github/scripts/pins.sh strips those
# quotes again when it hands the list to a matrix.
#
# A new pin is harvested, never guessed:
#     ci/fetch-verify.sh https://nginx.org/download/nginx-1.32.0.tar.gz - /tmp/n.tar.gz

# The releases build-test walks, and nothing older.  nginx keeps only the
# current stable and the current mainline alive; everything below 1.30 is
# archive material upstream and no FreeBSD port of this module uses it.
#   1.28.3  the last release of the previous stable line, kept as the floor
#           so a newer nginx interface cannot creep in unnoticed
#   1.31.6  current mainline, what www/nginx-devel ships
#
# The 1.30 stable line is missing on purpose, and it is the line www/nginx
# and www/nginx-full ship.  This module's test suite needs array-var and
# set-misc, and those two kill the worker process on 1.30.4 and on 1.30.5 --
# in an nginx built without this module just the same.  Their own suites
# fail there and pass on 1.31.6.  Until that is fixed upstream the shipped
# stable line cannot be covered here, and NGINX_VERSION below has to stay on
# mainline for the same reason.
NGINX_VERSIONS="1.28.3 1.31.6"
NGINX_1_28_3_SHA256=2c96a946bfb0882a21744ed429770a2123ae1828c7c48665092993ddee91a918
NGINX_1_31_6_SHA256=974ed5298a5e398e008704ed5db284e655fc270c596493dbccada452448fc9f1

# The one release every single version job uses: codeql, lint, sanitizers,
# valgrind and the FreeBSD run.  Mainline, not the shipped stable, for the
# reason given above.
NGINX_VERSION=1.31.6

# The companion modules this module's test suite needs, pinned by tag for
# readability AND by commit, because a tag can be moved after the fact.
NDK_TAG=v0.3.5
NDK_COMMIT=be363be99a26cecda89caa530ea1893728ba2ba4
ECHO_TAG=v0.65
ECHO_COMMIT=ebed47ce101b7f39683dbd9313c2d6163f27279a
SETMISC_TAG=v0.34
SETMISC_COMMIT=35365f29dcba9d2f8e9c2c15bd2a14e8a1446d7d
ARRAYVAR_TAG=v0.06
ARRAYVAR_COMMIT=32188f86599b47f7cd34340e5a2985bd9d550bf8

# actionlint checks the workflow definitions, so it is worth as much care as
# a build input: a swapped binary here would be the thing that tells us the
# workflows are fine.  The digest is the linux_amd64 release archive.
ACTIONLINT_VERSION=1.7.7
ACTIONLINT_SHA256=023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757
